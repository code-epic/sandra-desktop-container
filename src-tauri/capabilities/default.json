{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "shell:default",
    "fs:default",
    "notification:default",
    "fs:allow-download-write",
    "fs:allow-temp-write",
    {
      "identifier": "fs:scope",
      "allow": ["$DOWNLOAD/*", "$TEMP/*"]
    }
  ]
}
