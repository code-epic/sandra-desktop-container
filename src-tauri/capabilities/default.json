{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "splashscreen"],
  "permissions": [
    "opener:default",
    "dialog:default",
    "shell:default",
    "fs:default",
    "notification:default",
    "updater:default",
    "updater:allow-check",
    "fs:allow-download-write",
    "fs:allow-temp-write",
    "core:default",
    "fs:allow-appdata-read",
    "fs:allow-appdata-write",
    "fs:allow-desktop-read",
    "fs:allow-document-read",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    {
      "identifier": "fs:scope",
      "allow": [
        "$DOWNLOAD/**",
        "$TEMP/**",
        "$APPDATA/**",
        "$DESKTOP/**",
        "$DOCUMENT/**",
        "$HOME/**"
      ]
    }
  ]
}
