{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SandraDC",
  "version": "0.1.4",
  "identifier": "com.sandra.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/sandra-desktop-container/browser"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Sandra Desktop Container",
        "label": "main",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "visible": false,
        "minWidth": 1024,
        "minHeight": 768,
        "additionalBrowserArgs": "--ignore-certificate-errors"
      },
      {
        "width": 750,
        "height": 550,
        "decorations": false,
        "url": "/assets/splash.html",
        "label": "splashscreen",
        "center": true,
        "transparent": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Carlos Peña",
    "shortDescription": "Sandra Desktop Container",
    "longDescription": "SandraDC is a specialized tool for local proxying and desktop containerization.",
    "copyright": "Copyright © 2026 Carlos Peña. All rights reserved.",
    "targets": [
      "dmg",
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "macOS": {
      "signingIdentity": "Developer ID Application: Carlos Peña (Q7A9MLT493)",
      "entitlements": "entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/*"
    ]
  }
}