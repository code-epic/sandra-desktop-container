{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SandraDC",
  "version": "0.1.9",
  "identifier": "com.sandra.desktop",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/sandra-desktop-container/browser"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Sandra Desktop Container",
        "label": "main",
        "width": 1440,
        "height": 900,
        "maximized": true,
        "visible": false,
        "minWidth": 1024,
        "minHeight": 768,
        "additionalBrowserArgs": "--ignore-certificate-errors"
      },
      {
        "width": 750,
        "height": 550,
        "decorations": false,
        "url": "/assets/splash.html",
        "label": "splashscreen",
        "center": true,
        "transparent": true,
        "alwaysOnTop": true,
        "additionalBrowserArgs": "--ignore-certificate-errors"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Carlos Peña",
    "shortDescription": "Sandra Desktop Container",
    "longDescription": "SandraDC is a specialized tool for local proxying and desktop containerization.",
    "copyright": "Copyright © 2026 Carlos Peña. All rights reserved.",
    "targets": [
      "dmg",
      "nsis",
      "msi",
      "deb",
      "rpm",
      "appimage"
    ],
    "macOS": {
      "entitlements": "entitlements.plist"
    },
    "windows": {
      "wix": {
        "language": "es-ES"
      },
      "nsis": {
        "languages": ["Spanish"],
        "displayLanguageSelector": false,
        "compression": "lzma"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/*"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NENDMUFFODRDNTVFQTIKUldTaVhzV0Vyc0ZNR2FSNXVxcjhzNlY2ZXZYb0pQN21zZVVRbEJoNnlsc1kzRkthSU56TEplQWIK",
      "endpoints": [
        "https://raw.githubusercontent.com/code-epic/sandra-desktop-container/main/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}